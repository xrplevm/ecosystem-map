{
  "name": "my-xrplevm-ecosystem",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1051.0",
    "@hookform/resolvers": "^3.10.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "25.0.10",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vercel/node": "^5.8.3",
    "busboy": "^1.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.76.0",
    "react-scripts": "5.0.1",
    "sharp": "^0.35.1",
    "typescript": "4.9.5",
    "web-vitals": "5.1.0",
    "zod": "^3.25.76"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "test:watch": "react-scripts test",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"api/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "generate-seed": "tsx scripts/generate-seed.ts",
    "airtable:setup": "tsx scripts/airtable-setup.ts",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "**/__tests__/**/*.{ts,tsx}",
          "**/*.test.{ts,tsx}"
        ],
        "rules": {
          "jest/no-conditional-expect": "off",
          "testing-library/no-node-access": "off"
        }
      }
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^@smithy/core/(.+)$": "<rootDir>/node_modules/@smithy/core/dist-cjs/submodules/$1/index.js",
      "^@aws-sdk/core/(.+)$": "<rootDir>/node_modules/@aws-sdk/core/dist-cjs/submodules/$1/index.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "aws-sdk-client-mock": "^4.1.0",
    "tsx": "^4.22.3"
  }
}
