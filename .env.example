# Copy to `.env.local` for `vercel dev` and fill in real values.
# Loaded and validated at startup by `src/lib/env.ts` (Zod, fail-fast).
# Production values live in Vercel Project Settings → Environment Variables.

# ─── Slack ────────────────────────────────────────────────────────────────
# Bot token from the Slack app's "OAuth & Permissions" page. Required scopes:
#   commands, chat:write, chat:write.public, views:open, views:update,
#   reactions:write, metadata.message:read, channels:history, files:write,
#   files:read.
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Signing secret from "Basic Information" → "App Credentials".
# Verifies the HMAC on every /api/slack/* request. ≥32 chars.
SLACK_SIGNING_SECRET=your-signing-secret-32chars-min

# Channel ID (NOT name) where /api/submit posts pending messages and where
# /explorer-admin lists the queue. Right-click channel → "Copy link" → the
# ID is the trailing path segment (starts with C or G).
SLACK_APPROVAL_CHANNEL=C01234ABCD

# ─── AWS / S3 ─────────────────────────────────────────────────────────────
# Region of the bucket holding the canonical explorer-apps.json and dApp
# logos. Default eu-west-1.
AWS_REGION=eu-west-1

# Bucket name and JSON key. The JSON object is the single source of truth
# for the registry; logos live alongside it as `explorer-dapp-<id>.<ext>`.
S3_BUCKET=peersyst-development
S3_JSON_KEY=explorer-apps.json

# IAM credentials for the Slack approval handler (write paths). Read-only
# deploys can leave both empty. When set, the IAM policy must grant
# s3:GetObject, s3:GetObjectVersion, s3:PutObject, s3:DeleteObject scoped
# to the bucket. Bucket versioning MUST be ON for the conditional-PUT
# contract (`If-Match`) to be safe.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Anthropic ────────────────────────────────────────────────────────────
# API key used by /api/submit to run a Claude 3.5 Haiku integrity audit on
# new submissions and on edits that touch url/site/github. Optional — when
# absent, the audit returns a `warn` verdict and the human approver
# decides. Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# ─── Frontend (CRA, build-time) ───────────────────────────────────────────
# Public URL of the canonical explorer-apps.json the browser fetches.
# Inlined into the bundle by Create React App at build time, so changes
# require a redeploy. Defaults to the public S3 object on
# `peersyst-development`. Override per environment to point a fork at a
# different bucket.
REACT_APP_EXPLORER_APPS_URL=

# ─── Logo limits ──────────────────────────────────────────────────────────
# Maximum logo size accepted by /api/submit, in bytes. Default 500_000
# (~500KB). Mirrored on the client by the Zod resolver.
SUBMISSION_LOGO_MAX_BYTES=500000
